import socket


def main():
    with socket.create_connection(("127.0.0.1", 5050)) as conexion:
        for mensaje in ("hola", "redes", "adios"):
            conexion.sendall((mensaje + "\n").encode("utf-8"))
            respuesta = conexion.recv(1024).decode("utf-8").strip()
            print(f"Servidor responde: {respuesta}")


main()
